use super::RabbitConnectionManager;
use super::connection::close_quietly;
use super::message::PublishMessage;

use arc_swap::ArcSwap;
use lapin::types::ShortString;
use lapin::{BasicProperties, Channel, options::*};
use std::sync::{Arc, OnceLock, RwLock};
use std::time::Duration;
use tokio::sync::Mutex;
use serde_json::Value;
use std::collections::VecDeque;

pub trait Publisher {
    async fn publish<T>(&self, routing_key: &str, message: T) -> Result<(), lapin::Error>
    where
        T: PublishMessage + Send;

    async fn publish_raw(&self, routing_key: &str, payload: &[u8]) -> Result<(), lapin::Error>;
}

/// Publishes all messages and waits for every broker confirm.
///
/// Not atomic: on `Err` some messages may already be in the queue. A broker rejection (nack,
/// e.g. queue full with `x-overflow: reject-publish`) returns `Err` saying
/// "rejected N of M", but not which ones, so retrying the whole batch duplicates the accepted
/// ones. Use `publish` per message when each message must be accounted for.
pub trait BatchPublisher {
    async fn batch_publish<T>(
        &self,
        routing_key: &str,
        messages: Vec<T>,
    ) -> Result<(), lapin::Error>
    where
        T: PublishMessage + Send;

    async fn batch_publish_raw(
        &self,
        routing_key: &str,
        messages: Vec<&[u8]>,
    ) -> Result<(), lapin::Error>;
}

#[derive(Debug)]
pub struct RabbitProducer {
    manager: Arc<RabbitConnectionManager>,
    channel: ArcSwap<Option<Channel>>,
    reconnect_lock: Mutex<()>,
    exchange: Arc<str>,
}

const PUBLISH_OPTIONS: BasicPublishOptions = BasicPublishOptions {
    mandatory: false,
    immediate: false,
};

const CHANNEL_ACQUIRE_TIMEOUT: Duration = Duration::from_secs(30);

impl RabbitProducer {
    pub async fn new(
        manager: Arc<RabbitConnectionManager>,
        exchange: &str,
    ) -> Result<Self, lapin::Error> {
        let producer = Self {
            manager,
            channel: ArcSwap::new(empty_channel()),
            reconnect_lock: Mutex::new(()),
            exchange: Arc::from(exchange),
        };

        producer.retry_connect(CHANNEL_ACQUIRE_TIMEOUT).await?;
        Ok(producer)
    }

    async fn get_channel(&self) -> Result<Channel, lapin::Error> {
        if let Some(ch) = self.healthy_channel() {
            return Ok(ch);
        }

        tokio::time::timeout(
            CHANNEL_ACQUIRE_TIMEOUT,
            self.retry_connect(CHANNEL_ACQUIRE_TIMEOUT),
        )
        .await
        .unwrap_or_else(|_| {
            Err(lapin::Error::from(std::io::Error::new(
                std::io::ErrorKind::TimedOut,
                "timed out waiting for RabbitMQ channel",
            )))
        })
    }

    async fn retry_connect(&self, deadline: Duration) -> Result<Channel, lapin::Error> {
        const BASE: Duration = Duration::from_millis(500);
        const MAX: Duration = Duration::from_secs(10);
        let mut backoff = BASE;
        let mut attempt = 0u32;

        loop {
            attempt += 1;

            match self.try_establish_channel().await {
                Ok(ch) => {
                    if attempt > 1 {
                        tracing::info!("RabbitMQ channel established after {attempt} attempts");
                    }
                    return Ok(ch);
                }
                Err(e) if self.manager.is_closed() => return Err(e),
                Err(e) => {
                    tracing::warn!(
                        attempt,
                        backoff_ms = backoff.as_millis(),
                        timeout_secs = deadline.as_secs(),
                        "RabbitMQ channel unavailable, retrying: {e}"
                    );
                    tokio::time::sleep(backoff).await;
                    backoff = (backoff * 2).min(MAX);
                }
            }
        }
    }

    async fn try_establish_channel(&self) -> Result<Channel, lapin::Error> {
        let _guard = self.reconnect_lock.lock().await;

        if let Some(ch) = self.healthy_channel() {
            return Ok(ch);
        }

        let conn = match self.manager.get().await {
            Ok(c) => c,
            Err(e) => return Err(e),
        };

        let ch = match conn.create_channel().await {
            Ok(ch) => ch,
            Err(e) => {
                if !conn.status().connected() {
                    self.manager.invalidate();
                }
                return Err(e);
            }
        };

        if let Err(e) = ch.confirm_select(ConfirmSelectOptions::default()).await {
            self.manager.invalidate();
            return Err(e);
        }

        self.channel.store(Arc::new(Some(ch.clone())));
        Ok(ch)
    }

    #[inline]
    fn healthy_channel(&self) -> Option<Channel> {
        let guard = self.channel.load();
        let slot: &Option<Channel> = &**guard;
        slot.as_ref().filter(|ch| ch.status().connected()).cloned()
    }

    fn invalidate_channel(&self) {
        self.channel.store(empty_channel());
    }

    /// Closes the publishing channel (bounded by `CLOSE_TIMEOUT`, errors are logged).
    /// A later publish opens a new channel unless the manager was closed too.
    pub async fn close(&self) {
        let slot = self.channel.swap(empty_channel());
        if let Some(ch) = slot.as_ref().as_ref().filter(|ch| ch.status().connected()) {
            close_quietly("producer channel", ch.close(200, "shutdown".into())).await;
        }
    }

    pub async fn publish_raw(&self, routing_key: &str, payload: &[u8]) -> Result<(), lapin::Error> {
        self.publish_all(routing_key, vec![(payload.to_vec(), BasicProperties::default())])
            .await
    }

    /// Returns `Err` when the broker rejects the message (nack), not only on connection errors.
    pub async fn publish<T>(&self, routing_key: &str, message: T) -> Result<(), lapin::Error>
    where
        T: PublishMessage,
    {
        self.publish_all(routing_key, vec![encode(message)?]).await
    }

    /// See [`BatchPublisher`]: not atomic, a partial nack fails the whole call.
    pub async fn batch_publish_raw(
        &self,
        routing_key: &str,
        messages: Vec<&[u8]>,
    ) -> Result<(), lapin::Error> {
        let messages = messages
            .into_iter()
            .map(|p| (p.to_vec(), BasicProperties::default()))
            .collect();
        self.publish_all(routing_key, messages).await
    }

    /// See [`BatchPublisher`]: not atomic, a partial nack fails the whole call.
    pub async fn batch_publish<T>(
        &self,
        routing_key: &str,
        messages: Vec<T>,
    ) -> Result<(), lapin::Error>
    where
        T: PublishMessage,
    {
        let prepared = messages.into_iter().map(encode).collect::<Result<_, _>>()?;
        self.publish_all(routing_key, prepared).await
    }

    /// Publishes every message on one channel, then waits for all broker confirms.
    /// A nack (broker refused the message, e.g. queue full with `x-overflow: reject-publish`)
    /// is an error, not a success.
    async fn publish_all(
        &self,
        routing_key: &str,
        messages: Vec<(Vec<u8>, BasicProperties)>,
    ) -> Result<(), lapin::Error> {
        if messages.is_empty() {
            return Ok(());
        }
{% if "opentelemetry" in apm %}
        // Read here, in the caller's span: the spawned task below runs outside it.
        let span = tracing::Span::current();
        let messages: Vec<_> = messages
            .into_iter()
            .map(|(payload, props)| {
                let mut headers = props.headers().clone().unwrap_or_default();
                super::trace::add_trace_headers(&mut headers, &span);
                (payload, props.with_headers(headers))
            })
            .collect();
{% endif %}

        let ch = self.get_channel().await?;
        let exchange: ShortString = self.exchange.as_ref().into();
        let routing_key: ShortString = routing_key.into();
        let total = messages.len();

        // Spawned so a cancelled caller (client disconnect, timeout) can't stop a publish
        // halfway: lapin then parks its confirm on the channel, which piles up for its whole life.
        let task = tokio::spawn(async move {
            let mut confirms = Vec::with_capacity(total);
            for (payload, props) in messages {
                let rk = routing_key.clone();
                confirms.push(
                    ch.basic_publish(exchange.clone(), rk, PUBLISH_OPTIONS, &payload, props)
                        .await?,
                );
            }
            let mut nacked = 0usize;
            for confirm in confirms {
                if confirm.await?.is_nack() {
                    nacked += 1;
                }
            }
            Ok::<_, lapin::Error>(nacked)
        });

        match task.await {
            Ok(Ok(0)) => Ok(()),
            Ok(Ok(nacked)) => Err(lapin::Error::from(std::io::Error::other(format!(
                "RabbitMQ rejected {nacked} of {total} published message(s) (basic.nack)"
            )))),
            Ok(Err(e)) => {
                self.invalidate_channel();
                self.manager.invalidate();
                Err(e)
            }
            Err(e) => Err(lapin::Error::from(std::io::Error::other(format!(
                "RabbitMQ publish task failed: {e}"
            )))),
        }
    }
}

fn encode<T: PublishMessage>(message: T) -> Result<(Vec<u8>, BasicProperties), lapin::Error> {
    let (headers, payload) = message.into_parts();
    let bytes = serde_json::to_vec(&payload)
        .map_err(|e| lapin::Error::from(std::io::Error::new(std::io::ErrorKind::InvalidData, e)))?;
    Ok((bytes, BasicProperties::default().with_headers(headers)))
}

impl Publisher for RabbitProducer {
    async fn publish<T>(&self, routing_key: &str, message: T) -> Result<(), lapin::Error>
    where
        T: PublishMessage + Send,
    {
        self.publish(routing_key, message).await
    }

    async fn publish_raw(&self, routing_key: &str, payload: &[u8]) -> Result<(), lapin::Error> {
        self.publish_raw(routing_key, payload).await
    }
}

impl<T: Publisher> Publisher for Arc<T> {
    async fn publish<M>(&self, routing_key: &str, message: M) -> Result<(), lapin::Error>
    where
        M: PublishMessage + Send,
    {
        (**self).publish(routing_key, message).await
    }

    async fn publish_raw(&self, routing_key: &str, payload: &[u8]) -> Result<(), lapin::Error> {
        (**self).publish_raw(routing_key, payload).await
    }
}

impl BatchPublisher for RabbitProducer {
    async fn batch_publish<T>(
        &self,
        routing_key: &str,
        messages: Vec<T>,
    ) -> Result<(), lapin::Error>
    where
        T: PublishMessage + Send,
    {
        self.batch_publish(routing_key, messages).await
    }

    async fn batch_publish_raw(
        &self,
        routing_key: &str,
        messages: Vec<&[u8]>,
    ) -> Result<(), lapin::Error> {
        self.batch_publish_raw(routing_key, messages).await
    }
}

fn empty_channel() -> Arc<Option<Channel>> {
    static EMPTY: OnceLock<Arc<Option<Channel>>> = OnceLock::new();
    EMPTY.get_or_init(|| Arc::new(None)).clone()
}

#[derive(Debug, Clone)]
pub struct SentMessage {
    pub routing_key: String,
    pub payload: Value,
}

#[derive(Clone)]
pub struct MockProducer {
    sent_messages: Arc<RwLock<VecDeque<SentMessage>>>,
}

impl Default for MockProducer {
    fn default() -> Self {
        Self::new()
    }
}

impl MockProducer {
    pub fn new() -> Self {
        Self {
            sent_messages: Arc::new(RwLock::new(VecDeque::with_capacity(16))),
        }
    }

    pub fn get_sent_messages(&self) -> Vec<SentMessage> {
        self.sent_messages.read().unwrap().iter().cloned().collect()
    }

    pub fn find_sent_messages(&self, routing_key: &str) -> Option<SentMessage> {
        self.sent_messages
            .read()
            .unwrap()
            .iter()
            .find(|m| m.routing_key == routing_key)
            .cloned()
    }

    pub fn clear_messages(&self) {
        self.sent_messages.write().unwrap().clear();
    }

    pub fn get_message_count(&self) -> usize {
        self.sent_messages.read().unwrap().len()
    }

    pub fn get_last_message(&self) -> Option<SentMessage> {
        self.sent_messages.read().unwrap().back().cloned()
    }
}

impl Publisher for MockProducer {
    async fn publish<T>(&self, routing_key: &str, message: T) -> Result<(), lapin::Error>
    where
        T: PublishMessage + Send,
    {
        let (_meta, payload) = message.into_parts();

        let sent_message = SentMessage {
            routing_key: routing_key.to_string(),
            payload: serde_json::to_value(payload).unwrap_or(Value::Null),
        };

        self.sent_messages.write().unwrap().push_back(sent_message);
        Ok(())
    }

    async fn publish_raw(&self, routing_key: &str, payload: &[u8]) -> Result<(), lapin::Error> {
        let sent_message = SentMessage {
            routing_key: routing_key.to_string(),
            payload: serde_json::from_slice(payload).unwrap_or(Value::Null),
        };

        self.sent_messages.write().unwrap().push_back(sent_message);
        Ok(())
    }
}
