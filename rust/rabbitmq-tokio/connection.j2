{# type=static,filename=rabbitmq/connection.rs,min_version=1.0.0 #}
use arc_swap::ArcSwap;
use lapin::{Connection, ConnectionProperties};
use std::future::Future;
use std::sync::Arc;
use std::sync::atomic::{AtomicBool, Ordering};
use std::time::{Duration, Instant};
use tokio::sync::Mutex;

use super::RabbitConfiguration;

type Slot = Option<Arc<Connection>>;

/// Upper bound for every close/cancel handshake, so a dead broker can't hold shutdown hostage.
pub const CLOSE_TIMEOUT: Duration = Duration::from_secs(5);

#[derive(Debug)]
pub struct RabbitConnectionManager {
    connection_name: Arc<str>,
    uri: Arc<str>,
    current: ArcSwap<Slot>,
    reconnect_gate: Mutex<Option<Instant>>,
    closed: AtomicBool,
}

impl RabbitConnectionManager {
    pub fn new(config: RabbitConfiguration) -> Self {
        Self {
            connection_name: Arc::from(config.connection_name.as_str()),
            uri: Arc::from(config.uri.as_str()),
            current: ArcSwap::from_pointee(None),
            reconnect_gate: Mutex::new(None),
            closed: AtomicBool::new(false),
        }
    }

    pub fn is_connected(&self) -> bool {
        self.get_if_ready().is_some()
    }

    pub fn invalidate(&self) {
        self.current.store(Arc::new(None));
    }

    pub fn is_closed(&self) -> bool {
        self.closed.load(Ordering::Acquire)
    }

    /// Gracefully closes the AMQP connection (close / close-ok handshake) and stops reconnecting.
    /// Idempotent, never fails (errors are logged) and bounded by [`CLOSE_TIMEOUT`].
    pub async fn close(&self) {
        self.closed.store(true, Ordering::Release);
        // Wait out an in-progress connect so its connection gets closed too, not leaked.
        let _gate = tokio::time::timeout(CLOSE_TIMEOUT, self.reconnect_gate.lock()).await;
        let slot = self.current.swap(Arc::new(None));

        if let Some(conn) = slot.as_ref().as_ref().filter(|c| c.status().connected()) {
            close_quietly("connection", conn.close(200, "shutdown".into())).await;
        }
    }

    pub async fn get(&self) -> Result<Arc<Connection>, lapin::Error> {
        if let Some(conn) = self.get_if_ready() {
            return Ok(conn);
        }

        let mut last_attempt = self.reconnect_gate.lock().await;

        // Other worker may have connected while this waited for gate
        if let Some(conn) = self.get_if_ready() {
            return Ok(conn);
        }

        if let Some(ts) = *last_attempt {
            let cooldown = Duration::from_millis(500);
            let elapsed = ts.elapsed();
            if elapsed < cooldown {
                drop(last_attempt);
                tokio::time::sleep(cooldown - elapsed).await;
                if let Some(conn) = self.get_if_ready() {
                    return Ok(conn);
                }
                last_attempt = self.reconnect_gate.lock().await;
            }
        }

        if self.is_closed() {
            return Err(lapin::Error::from(std::io::Error::new(
                std::io::ErrorKind::NotConnected,
                "RabbitMQ connection manager is closed",
            )));
        }

        *last_attempt = Some(Instant::now());

        let conn = Connection::connect(
            &self.uri,
            ConnectionProperties::default()
                .with_connection_name((*self.connection_name).into()),
        )
            .await?;

        let conn = Arc::new(conn);

        self.current.store(Arc::new(Some(conn.clone())));

        drop(last_attempt);

        Ok(conn)
    }

    fn get_if_ready(&self) -> Option<Arc<Connection>> {
        let guard = self.current.load();
        let slot: &Slot = &**guard;
        slot.as_ref()
            .filter(|c| c.status().connected())
            .cloned()
    }
}

/// Runs a close/cancel handshake bounded by [`CLOSE_TIMEOUT`], logging instead of failing.
pub async fn close_quietly(what: &str, fut: impl Future<Output = Result<(), lapin::Error>>) {
    match tokio::time::timeout(CLOSE_TIMEOUT, fut).await {
        Ok(Ok(())) => tracing::debug!("RabbitMQ {what} closed"),
        Ok(Err(e)) => tracing::warn!("RabbitMQ {what} close failed: {e}"),
        Err(_) => tracing::warn!("RabbitMQ {what} close timed out after {CLOSE_TIMEOUT:?}"),
    }
}
